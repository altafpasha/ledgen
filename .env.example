# Application
APP_NAME=lead-intelligence-api
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database (Supabase PostgreSQL / local PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadgen
# Sync Database URL for Alembic / sync workers (optional, derived if omitted)
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/leadgen

# Supabase (Used for direct storage / storage bucket / service-role operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Apify (Lead Discovery)
APIFY_API_TOKEN=your-apify-api-token
APIFY_ACTOR_ID=compass~crawler-google-places

# Apollo.io (Contact Enrichment)
APOLLO_API_KEY=your-apollo-api-key

# OpenRouter / Jev Intelligence Model
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Sheets API (Export & Sync)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials
ADMIN_EMAIL=admin@leadgen.local
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,https://admin.yourdomain.com

# Budget & Concurrency Limits
MAX_CONCURRENT_JOBS=5
MAX_LEADS_PER_CAMPAIGN=1000
MAX_APOLLO_CREDITS_PER_CAMPAIGN=100
MAX_AI_REQUESTS_PER_CAMPAIGN=500
REQUEST_TIMEOUT_SECONDS=30

# Automated Daily Scraping Targets (Add any cities/locations & business categories you want)
DEFAULT_SCRAPE_LOCATIONS=KGF, Bangarapet, Bangalore
DEFAULT_SCRAPE_CATEGORIES=Dental Clinic, Healthcare Clinic, Software Company, Digital Marketing, Retail
DEFAULT_DAILY_LEAD_LIMIT=50

# Port & Host Bindings for Docker / Local (Change if port 80/443/5432 is already in use on your VPS)
POSTGRES_PORT=5432
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Frontend API & Documentation Controls
ENABLE_FRONTEND_API=true
ENABLE_API_DOCS=true

# Mock Providers Switch (Set to true for test/offline without incurring provider costs)
MOCK_PROVIDERS=true

